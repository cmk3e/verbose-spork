# Copy to /etc/totebot.env (sudo cp deploy/totebot.env.example /etc/totebot.env) and edit.

# --- Login for the web page (REQUIRED on a public VM) ---
APP_USERNAME=admin
APP_PASSWORD=change-me-to-something-long

# Track timezone used to read post times on uploaded cards
APP_TZ=America/New_York
DATA_DIR=/var/lib/totebot
PORT=8000
# Public address of the site, used for tap-to-open links in push notifications
PUBLIC_URL=

# --- Where live odds come from ---
#   mock   = simulated tote (for testing)
#   manual = odds pushed to POST /api/races/{id}/tote (your own scraper, or typed on the iPad)
#   http   = any JSON odds API (configure TOTE_HTTP_* below)
TOTE_SOURCE=mock

# --- Timing (minutes to post) ---
FETCH_MTP=3
PUBLISH_MTP=2

# --- Your engine (module name of the .py file in the repo root) ---
ENGINE_MODULE=horseplay_betting_engine_v3
BLEND_ALPHA=0.6
BLEND_BETA=0.4

# --- Bankroll / Kelly ---
BANKROLL=1000
FRACTIONAL_KELLY=0.25
MAX_RACE_EXPOSURE=0.05
ODDS_HAIRCUT=0.05
MIN_WIN_BET=2

# --- Exotics ---
EXACTA_BASE=1
EXACTA_BUDGET=20
SUPERFECTA_BASE=0.10
SUPERFECTA_BUDGET=12
MIN_EDGE=0.10

# --- Push notifications to the iPad (install the free "ntfy" app, subscribe to this topic) ---
# Pick a long random topic name; anyone who knows it can read your tickets.
NTFY_TOPIC=

# --- Generic HTTP/JSON odds source (TOTE_SOURCE=http) ---
# URL placeholders: {track} {race} {date} (YYYY-MM-DD) {yyyymmdd} {ref} (race's source_ref)
TOTE_HTTP_URL=
# JSON object of request headers, e.g. {"Authorization": "Bearer YOUR_KEY"}
TOTE_HTTP_HEADERS=
# Dotted paths into the provider's JSON response
TOTE_HTTP_RUNNERS_PATH=runners
TOTE_HTTP_PROGRAM_FIELD=program_number
TOTE_HTTP_ODDS_FIELD=odds
TOTE_HTTP_SCRATCH_FIELD=scratched
TOTE_HTTP_POST_TIME_PATH=
TOTE_HTTP_EXACTA_PATH=
TOTE_HTTP_EXACTA_BASE=2
# How to read bare numbers in the odds field: to1 (tote style, 3 = 3-1) or decimal
TOTE_HTTP_ODDS_FORMAT=to1

# --- AmWager (used by deploy/amwager-discover.sh and TOTE_SOURCE=amwager) ---
AMWAGER_USERNAME=
AMWAGER_PASSWORD=
